# Copy to .env at the repository root for Docker Compose.
# For the manual backend command, copy this file to backend/.env instead.
ENVIRONMENT=development
DEMO_MODE=true
# Change for deployment; use `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
SECRET_KEY=local-development-only-replace-with-a-random-key-before-deploying
DATABASE_URL=sqlite+aiosqlite:///./smarthire.db
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
REDIS_URL=redis://localhost:6379/0
POSTGRES_PASSWORD=local-owner-change-me
APP_DB_PASSWORD=local-app-change-me
# Optional: enabling this replaces keyword matching / demo interviews with OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: configure test keys, a recurring Stripe price, and webhook signing secret.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
# Optional: email verification and password-reset delivery via Celery + SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@your-domain.example
